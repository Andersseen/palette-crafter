/* Build config for the publishable `@palette-crafter/core` package.
   Compiles only src/shared (pure logic, zero dependencies) to ESM + types. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/core",
    "rootDir": "./src/shared",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": false,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],
    "importHelpers": false,
    "noEmit": false,
    "paths": {}
  },
  "include": ["src/shared/**/*.ts"],
  "exclude": ["src/shared/**/*.spec.ts"]
}
