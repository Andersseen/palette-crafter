{
  "name": "palette-crafter",
  "private": false,
  "description": "A lightweight tool to generate dynamic color palettes (background, foreground, primary, secondary) for Angular and Tailwind CSS v4.",
  "author": {
    "name": "Andrii Pap",
    "username": "Andersseen",
    "url": "https://github.com/Andersseen"
  },
  "license": "MIT",
  "keywords": [
    "angular",
    "tailwind",
    "tailwindcss",
    "theme",
    "palette",
    "color",
    "css-variables",
    "angular-components",
    "tailwind-4",
    "dark-mode",
    "light-mode"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Andersseen/palette-crafter.git"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/palette-crafter/issues"
  },
  "homepage": "https://palette-crafter.pages.dev",
  "scripts": {
    "dev": "CHOKIDAR_USEPOLLING=true ng serve",
    "start": "pnpm dev",
    "clean": "rm -rf dist .angular/cache",
    "build": "ng build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:cf": "BUILD_PRESET=cloudflare-pages ng build",
    "dev:cf": "pnpm build:cf && wrangler pages dev",
    "deploy:cf": "pnpm build:cf && wrangler pages deploy"
  },
  "dependencies": {
    "@analogjs/content": "^2.3.1",
    "@analogjs/router": "^2.3.1",
    "@angular/animations": "^21.2.3",
    "@angular/common": "^21.2.3",
    "@angular/compiler": "^21.2.3",
    "@angular/core": "^21.2.3",
    "@angular/forms": "^21.2.3",
    "@angular/platform-browser": "^21.2.3",
    "@angular/platform-server": "^21.2.3",
    "@angular/router": "^21.2.3",
    "@tailwindcss/postcss": "^4.1.11",
    "@voltui/components": "^0.6.0",
    "angular-movement": "^0.5.0",
    "autoprefixer": "^10.4.21",
    "h3": "^1.15.4",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "postcss": "^8.5.6",
    "prismjs": "^1.29.0",
    "rxjs": "^7.8.1",
    "tailwindcss": "^4.1.11",
    "tslib": "^2.5.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.3.1",
    "@analogjs/vite-plugin-angular": "^2.3.1",
    "@analogjs/vitest-angular": "^2.3.1",
    "@angular/build": "^21.2.3",
    "@angular/cdk": "21.2.10",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.3",
    "@nx/devkit": "^22.6.1",
    "@nx/vite": "^22.0.0",
    "@types/node": "^22.15.30",
    "jsdom": "^22.0.0",
    "nx": "^22.6.1",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.76.0"
  },
  "type": "module"
}
